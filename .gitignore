# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Workspace common ignores
# (Each subdirectory has its own .gitignore for specific needs)

# dependencies
node_modules

# yarn
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files
.env*
!.env.example

# OS
.DS_Store
*.pem
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local development databases
*.db
*.db-journal
prisma/dev.db*

# local development tools
.claude
.roo
prompts
logs

