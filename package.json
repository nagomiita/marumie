{
  "name": "marumie",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "// Development": "========================================",
    "dev": "pnpm supabase:start && concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:setup": "pnpm install && pnpm backend:setup && pnpm supabase:start && pnpm db:migrate && echo 'Setup complete! Run: pnpm dev'",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "cd backend && uv run uvicorn app.main:get_app --reload --factory",
    "// Build & Deploy": "====================================",
    "build": "pnpm build:frontend",
    "build:frontend": "pnpm --filter frontend build",
    "start": "pnpm --filter frontend start",
    "// Code Quality": "======================================",
    "lint": "pnpm lint:frontend",
    "lint:frontend": "pnpm --filter frontend lint",
    "format": "npx biome format --write .",
    "typecheck": "pnpm typecheck:frontend",
    "typecheck:frontend": "pnpm --filter frontend type-check",
    "// Testing": "===========================================",
    "test": "pnpm test:frontend",
    "test:frontend": "pnpm --filter frontend test",
    "test:watch": "pnpm test:frontend -- --watch",
    "// Backend & Database": "================================",
    "backend:setup": "cd backend && uv sync",
    "db:migrate": "cd backend && uv run alembic upgrade head",
    "db:migrate:create": "cd backend && uv run alembic revision --autogenerate -m",
    "db:seed": "cd backend && uv run python -m app.scripts.seed",
    "db:reset": "pnpm supabase:reset && pnpm db:migrate && pnpm db:seed",
    "postinstall": "npx simple-git-hooks",
    "// Supabase": "==========================================",
    "supabase:init": "pnpm dlx supabase@2.67.1 init",
    "supabase:start": "pnpm dlx supabase@2.67.1 start",
    "supabase:stop": "pnpm dlx supabase@2.67.1 stop",
    "supabase:status": "pnpm dlx supabase@2.67.1 status",
    "supabase:reset": "pnpm dlx supabase@2.67.1 db reset",
    "supabase:types": "pnpm dlx supabase@2.67.1 gen types typescript --local > supabase/types.gen.ts",
    "// Utilities": "=========================================",
    "clean": "pnpm supabase:stop && rm -rf node_modules */node_modules",
    "fresh": "pnpm clean && pnpm install && pnpm dev:setup"
  },
  "dependencies": {
    "@nivo/sankey": "^0.99.0",
    "@supabase/supabase-js": "^2.55.0",
    "csv-parse": "^5.5.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^10.0.0",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npm run format"
  }
}